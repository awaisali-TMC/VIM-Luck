# TMC eInvoice — backend configuration template (Lucky Cement instance)
#
# Copy to backend/.env and fill in. Every key below maps 1:1 to a field in
# app/config.py; anything omitted falls back to the default shown here.
# backend/.env is git-ignored — never commit real values.
#
# In production these are set as Cloud Run env vars / Secret Manager refs, NOT
# from a .env file. See CONTEXT.md §2 for the deployed values.
# The defaults in this file are tuned for LOCAL DEV (SQLite, SAP off, docs on).

# ─── Debug / sessions ────────────────────────────────────────────────────────
# DEBUG gates /docs, /redoc, /openapi.json and dev-only conveniences that leak
# secrets (e.g. returning supplier OTP codes in API responses).
# KEEP FALSE IN PRODUCTION. The deployed Lucky Cement demo runs DEBUG=true only
# because SAP_MODE=fake requires it (CONTEXT.md §5).
DEBUG=true

# Session token lifetime in hours. 0 disables expiry.
TOKEN_TTL_HOURS=720

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite needs no setup. Postgres in cloud: postgresql+asyncpg://user:pass@host/db
# (prod reads this from the `database-url` secret).
DATABASE_URL=sqlite+aiosqlite:///./invoices.db

# ─── Gemini (the active AI extraction path) ──────────────────────────────────
# Required for invoice extraction, tax detection, line items and product
# matching. The app bridges this to GOOGLE_API_KEY for the ADK agent.
# Prod reads it from the `gemini-api-key` secret.
GEMINI_API_KEY=

# ONE switch for every Gemini call site — extraction, segmentation, tax detection,
# line items, product matching, PO extraction and the ADK agent all read this.
# Change it here (or as a Cloud Run env var — no rebuild needed) to move every
# call at once. An unknown id is not validated at startup; it fails on the first
# API call. Note Google retires ids for new API projects: gemini-2.5-flash
# started returning 404 on 2026-08-31.
GEMINI_MODEL=gemini-3.5-flash

# ─── Google Cloud / Document AI (legacy path) ────────────────────────────────
# Only needed for the superseded document_ai.py pipeline; gemini_extract.py
# does not use these. Safe to leave blank.
GCP_PROJECT_ID=
GCP_LOCATION=us
DOCAI_PROCESSOR_ID=
# Local: path to a service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json
# Cloud: base64-encoded service-account JSON. If set, TAKES PRIORITY over the
# file path above (main.py writes it to disk at startup).
GCP_CREDENTIALS_JSON=

# ─── File storage ────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# ─── Email invoice inbox (Gmail IMAP) ────────────────────────────────────────
# Optional — leave blank to disable the email ingestion source.
# GMAIL_APP_PASSWORD is a Google App Password, not the account password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_FETCH_FOLDER=INBOX
GMAIL_MAX_FETCH=50

# ─── FBR (Pakistan tax authority) ────────────────────────────────────────────
# ATL lookups prefer the app DB's atl_taxpayers table (~8.5M rows on this
# instance, loaded via backend/import_atl.py). FBR_ATL_DB_PATH is a DEV-ONLY
# local SQLite fallback — GET /api/fbr/atl-stats reads only that file, so it
# reports 0 in cloud. Never use it as a health check.
FBR_ATL_DB_PATH=./atl.db

# Live IRIS 2.0 API lookup — disabled by default; the ATL table is authoritative.
FBR_LIVE_LOOKUP_ENABLED=false
FBR_USER_ID=
FBR_PASSWORD=
FBR_API_URL=https://api.fbr.gov.pk/iris2ovs/v1/getdata
FBR_IRIS_JS_INDEX=https://iris.fbr.gov.pk/public/ATL
FBR_REQUEST_TIMEOUT=30
FBR_MAX_RETRIES=3
FBR_RETRY_DELAY=2
FBR_TOKEN_CACHE_TTL=3600
FBR_BATCH_DELAY=0.5
# ATL service codes (income tax / sales tax / AJK)
FBR_PROTOCOL_INCOME_TAX=1004
FBR_PROTOCOL_SALES_TAX=1005
FBR_PROTOCOL_AJK=3001

# ─── SAP RFC ─────────────────────────────────────────────────────────────────
# SAP_ENABLED gates every live RFC call. With it FALSE, parking validation is
# assumed to pass, parking/posting is SIMULATED (placeholder document number)
# and SAP-backed dropdowns fall back to static defaults — so the approval flow
# still works end-to-end without SAP. Default false here because local dev
# needs the NW RFC SDK + network access to the SAP host.
# THE DEPLOYED INSTANCE RUNS SAP_ENABLED=true + SAP_MODE=fake (fixture SAP; CONTEXT.md §5).
SAP_ENABLED=false

# SAP_MODE picks WHICH CONNECTOR answers, and is a different switch from
# SAP_ENABLED above:
#   live  the real RFC connector — needs the NW RFC SDK and network access
#   fake  an in-process connector backed by SQLite fixtures, for local demos and
#         offline tests. Requires DEBUG=true; the module refuses to import
#         otherwise, so it can never load in production.
#
# For a demo you want BOTH of these, and it is the easiest thing to get wrong:
#   SAP_ENABLED=true   so the routers take the real code path and reach the connector
#   SAP_MODE=fake      so the connector is the fixture one
# SAP_ENABLED=false bypasses the connector altogether and gives you the old
# placeholder simulation instead — no POs to match, no vendors, nothing that can fail.
# Verify with GET /api/sap/test: it reports "mode": "fake" or "live".
SAP_MODE=live

# Where the fake connector keeps its fixture data. Empty = in memory, rebuilt on
# every start, so demos repeat identically. Set a path and it becomes a SQLite
# file you can open in any DB browser WHILE THE APP RUNS — useful for showing
# that an invoice really landed in "SAP":
#     sqlite3 backend/sap_fake.db "SELECT BELNR, GJAHR, RBSTAT FROM RBKP;"
# It is seeded once and then persists across restarts; delete the file to reset.
# Ignored unless SAP_MODE=fake.
SAP_FAKE_DB_PATH=

# Windows: directory holding sapnwrfc.dll (ctypes path).
# The Linux Docker image overrides this to /opt/nwrfcsdk and uses PyRFC.
SAP_NWRFC_SDK_PATH=C:\nwrfcsdk

# Connection — values below are inherited from the Hilton instance (OGDCL DEV) and
# unused here: this instance only runs SAP_MODE=fake.
# SAP_PASSWD comes from the `sap-passwd` secret in prod; never commit it.
SAP_ASHOST=172.18.1.8
SAP_SYSNR=00
SAP_CLIENT=100
SAP_SYSID=DEV
SAP_SAPROUTER=/H/124.109.53.102
SAP_USER=
SAP_PASSWD=

# ─── CORS ────────────────────────────────────────────────────────────────────
# JSON list, explicit allowlist (no wildcard). Add the deployed portal origin
# in cloud: ["https://lucky-cement-vim-web-527930147362.us-central1.run.app"]
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:8081"]

# ─── Initial admin bootstrap ─────────────────────────────────────────────────
# Only used when the internal_users table is EMPTY (first boot of a fresh DB).
# Leave INITIAL_ADMIN_PASSWORD blank to force a random password that is logged
# once (in full only when DEBUG=true) rather than a weak default.
# Prod reads it from the `initial-admin-password` secret.
# Note: the default email is NOT re-branded — it is literally admin@tmcltd.com.
INITIAL_ADMIN_EMAIL=admin@tmcltd.com
INITIAL_ADMIN_PASSWORD=

# ─── Supplier demo OTP ───────────────────────────────────────────────────────
# A fixed OTP that ALWAYS works for any verified supplier mobile — never
# consumed, never expires. There is no SMS gateway, so this is currently the
# only way suppliers can log in. Leave blank once a real gateway is wired up.
# Prod reads it from the `supplier-demo-otp` secret.
SUPPLIER_DEMO_OTP=

